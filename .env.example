# Server-only credentials for LIVE mode. /demo and npm run check need no keys.
# Copy to .env.local; never commit populated credentials.
OPENAI_API_KEY=
TYPESAFE_API_KEY=
# Optional: route the same Jev question through OpenRouter instead of TypeSafe.
# Set BOTH of these to switch; an OpenRouter key is not a GPT-Live WebRTC key.
# JEV_PROVIDER=openrouter
# OPENROUTER_API_KEY=

# Live durable recording; set by npm run convex:dev. Never needed by /demo.
NEXT_PUBLIC_CONVEX_URL=
